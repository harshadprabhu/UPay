<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.UrgentPay" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/copper</item>
        <item name="colorOnPrimary">@color/cocoa_900</item>
        <item name="colorSecondary">@color/copper_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/cocoa_900</item>
        <item name="android:windowBackground">@color/cocoa_900</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="GlassButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">@color/cream</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
