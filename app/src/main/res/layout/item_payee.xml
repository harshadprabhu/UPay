<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/btn_ghost"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="18dp"
    android:paddingVertical="15dp">

    <TextView
        android:id="@+id/payeeInitial"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/circle_copper"
        android:gravity="center"
        android:text="M"
        android:textColor="@color/cocoa_900"
        android:textSize="17sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/payeeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Name"
            android:textColor="@color/cream"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/payeeVpa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="vpa"
            android:textColor="@color/cream_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/payeeBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/pill"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:text="#1"
        android:textColor="@color/copper_light"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
