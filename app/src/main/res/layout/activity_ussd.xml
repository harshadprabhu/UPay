<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="48dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/offline_session"
        android:textColor="@color/cream"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvUssdStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/ussd_starting"
        android:textColor="@color/copper_light"
        android:textSize="13sp" />

    <!-- Response card -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="18dp"
        android:background="@drawable/glass_card_strong"
        android:padding="20dp"
        android:scrollbars="none">

        <TextView
            android:id="@+id/tvUssdResponse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/cream"
            android:textSize="16sp"
            android:lineSpacingMultiplier="1.3"
            android:fontFamily="monospace" />
    </ScrollView>

    <!-- Reply row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etReply"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/field_glass"
            android:hint="@string/reply_hint"
            android:inputType="text"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            android:textColor="@color/cream"
            android:textColorHint="@color/cream_muted"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/btnSendReply"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/circle_copper"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_arrow" />
        </LinearLayout>
    </LinearLayout>

    <!-- Secure PIN handoff -->
    <LinearLayout
        android:id="@+id/btnSecureDialer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/btn_ghost"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="15dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_shield" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/open_secure_dialer"
            android:textColor="@color/cream"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
