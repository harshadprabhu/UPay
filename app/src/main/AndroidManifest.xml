<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        UrgentPay needs NO INTERNET permission by design. It works offline:
        - CAMERA: read a UPI QR code on-device (offline decoding).
        - CALL_PHONE: run the *99# / IVR offline payment rails.
        Both are requested at runtime and are optional (manual entry / dialer
        fallbacks exist).
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_short"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.UrgentPay">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Pinned to portrait on purpose: the scanner library's own
            CaptureActivity is declared sensorLandscape in its manifest, which an
            app cannot override, so UPay ships its own screen instead.
        -->
        <activity
            android:name=".ScannerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.UrgentPay.Scanner" />

        <activity
            android:name=".PaymentActivity"
            android:exported="false" />

        <activity
            android:name=".UssdSessionActivity"
            android:exported="false" />

    </application>

</manifest>
